# OpenRouter API Key (REQUIRED)
# Get your key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Groq API Key (OPTIONAL - for voice transcription)
# Get your key from: https://console.groq.com/keys
# GROQ_API_KEY=gsk_your-key-here

# LLM Council API token (OPTIONAL)
# Every /api request must send this as "Authorization: Bearer <token>".
# If unset, a random token is generated, saved to data/api_token, and a
# one-click login link is written to data/api_url. The web UI asks for it once and remembers it.
# LLM_COUNCIL_API_TOKEN=change-me-to-a-long-random-string

# Allowed browser origins for the API (OPTIONAL, comma-separated)
# Default: http://localhost:5173,http://127.0.0.1:5173
# Set this to the URL you open the UI at when accessing it over your LAN.
# LLM_COUNCIL_CORS_ORIGINS=http://192.168.1.50:5173
